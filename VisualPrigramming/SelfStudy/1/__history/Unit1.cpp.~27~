void __fastcall TРомановНикитаМаксимович::Button1Click(TObject *Sender)
{
//  Вычисление треугольника по трем сторонам
	double A = Edit1->Text.ToDouble();
	double B = Edit2->Text.ToDouble();
	double C = Edit3->Text.ToDouble();
	double P = (A + B + C) / 2.0; //Вычисление периметра
	double S = round(sqrt(P*(P-A)*(P-B)*(P-C))*100)/100;

	Edit4->Text = S;
}
//---------------------------------------------------------------------------

void __fastcall TРомановНикитаМаксимович::Button2Click(TObject *Sender)
{
 	Edit1->Clear();
	Edit2->Clear();
	Edit3->Clear();
    Edit4->Clear();
}
