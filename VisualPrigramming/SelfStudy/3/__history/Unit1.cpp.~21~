//--------------------- НИЖЕ ПРИВЕДЕНЫ РЕАЛИЗАЦИИ МЕТОДОВ -------------------
//----- NewDocument(), OpenDocument(), SaveDocument(), SaveAsDocument() -----
void TForm1::NewDocument(void)
{
	int Rc = Application->MessageBox(
		L"Создать новый документ?",
		L"Подтверждение", MB_YESNO | MB_ICONQUESTION);

	if (Rc == IDYES)
	{
		FileName = "";
		ShowMessage(L"Новый документ создан (пока пустой).");
//		Application->MessageBoxW(L"Новый документ создан (пока пустой)." + FileName, L"", MB_OK);
	}
} // NewDocument

void TForm1::OpenDocument(void)
{
	if (OpenDialog1->Execute())
	{
		FileName = OpenDialog1->FileName;
		ShowMessage(L"Файл выбран: " + FileName);
//		Application->MessageBoxW(L"Файл выбран:" + FileName, L"", MB_OK);
	}
} // OpenDocument

void TForm1::SaveDocument(void)
{
	if (FileName.IsEmpty( )) {
		SaveAsDocument( );
	} else {
		Memo1->Lines->SaveToFile(FileName);
//		Application->MessageBoxW(L"Файл сохранен:" + FileName, L"", MB_OK);
	} // else
//	Memo1->Modified = false;
} // SaveDocument

void TForm1::SaveAsDocument(void)
{
	if (SaveDialog1->Execute())
	{
		FileName = SaveDialog1->FileName;
		ShowMessage(L"Файл сохранён как: " + FileName);
//		Application->MessageBoxW(L"Файл сохранён как::" + FileName, L"", MB_OK);
	}
//	Memo1->Modified = false;
} // SaveAsDocument

