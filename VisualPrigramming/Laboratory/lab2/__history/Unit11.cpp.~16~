    Shape1->Brush->Color = RGB(255 *CheckBox1->Checked, 255 * CheckBox2->Checked, 255*CheckBox3->Checked);
}
//---------------------------------------------------------------------------
void __fastcall TForm11::ComboBox1Change(TObject *Sender)
{
	if (ComboBox1->Text == "Черный") Shape1->Brush->Color = RGB(0, 0, 0);
	if (ComboBox1->Text == "Красный") Shape1->Brush->Color = RGB(255, 0, 0);
	if (ComboBox1->Text == "Зеленый") Shape1->Brush->Color = RGB(0, 255, 0);
	if (ComboBox1->Text == "Синий") Shape1->Brush->Color = RGB(0, 0, 255);
	if (ComboBox1->Text == "Желтый") Shape1->Brush->Color = RGB(255, 255, 0);
	if (ComboBox1->Text == "Малиновый") Shape1->Brush->Color = RGB(255, 0, 255);
	if (ComboBox1->Text == "Голубой") Shape1->Brush->Color = RGB(0, 255, 255);
	if (ComboBox1->Text == "Белый") Shape1->Brush->Color = RGB(255, 255, 255);
}
