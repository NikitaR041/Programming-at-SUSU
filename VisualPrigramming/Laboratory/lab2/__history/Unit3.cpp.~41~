//--------------------- НИЖЕ ПРИВЕДЕНЫ РЕАЛИЗАЦИИ МЕТОДОВ -------------------
//----- NewDocument(), OpenDocument(), SaveDocument(), SaveAsDocument() -----
void TForm3::NewDocument(void)
{
	int Rc;
	if (Memo1->Modified) {
		Rc = Application->MessageBox(
			L"Текст был изменен\nСохранить изменение?",
			L"Вопрос", MB_YESNOCANCEL | MB_ICONQUESTION);
		if (Rc == IDCANCEL) return;
		if (Rc == IDYES) {
			SaveDocument( );
		} // if
	} // if
	Memo1->Clear( );
	FileName = "";
} // NewDocument

void TForm3::OpenDocument(void)
{
	int Rc;
	if (Memo1->Modified) {
		Rc = Application->MessageBox(
			L"Текст был изменен\nСохранить изменение?",
			L"Вопрос", MB_YESNOCANCEL | MB_ICONQUESTION);

		if (Rc == IDCANCEL) return;
		if (Rc == IDYES) {
			SaveDocument( );
		} // if
	} // if
	Rc = OpenDialog1->Execute( );
	if (Rc) {
		Memo1->Lines->LoadFromFile(OpenDialog1->FileName);
		FileName = OpenDialog1->FileName;
	} // if
} // OpenDocument

void TForm3::SaveDocument(void)
{
	if (FileName.IsEmpty( )) {
		SaveAsDocument( );
	} else {
		Memo1->Lines->SaveToFile(FileName);
	} // else
    Memo1->Modified = false;
} // SaveDocument

void TForm3::SaveAsDocument(void)
{
	int Rc;
	SaveDialog1->FileName = FileName;
	Rc = SaveDialog1->Execute( );
	if (Rc) {
		Memo1->Lines->SaveToFile(SaveDialog1->FileName);
		FileName = SaveDialog1->FileName;
	} // if
    Memo1->Modified = false;
} // SaveAsDocument


