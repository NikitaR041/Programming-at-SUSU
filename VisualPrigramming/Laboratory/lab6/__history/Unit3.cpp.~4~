#include <vcl.h>
#pragma hdrstop

#include "Unit3.h"
//---------------------------------------------------------------------------
#pragma package(smart_init)
#pragma resource "*.dfm"
TForm3 *Form3;
//---------------------------------------------------------------------------
__fastcall TForm3::TForm3(TComponent* Owner)
	: TForm(Owner)
{
}
//---------------------------------------------------------------------------
void __fastcall TForm3::PaintBox1Paint(TObject *Sender)
{
    PaintBox1->Canvas->Pen->Color = clBlue;
	PaintBox1->Canvas->Pen->Width = 5;
	PaintBox1->Canvas->Brush->Color = clYellow;
	PaintBox1->Canvas->Ellipse(x-50, y-50, x+50, y+50);
}
//---------------------------------------------------------------------------
void __fastcall TForm3::FormKeyDown(TObject *Sender, WORD &Key, TShiftState Shift)

{
if (Key == VK_LEFT) {
	if (x >= 65) x -= 10;
	} // if
	if (Key == VK_RIGHT) {
		if (x <= cx-65) x += 10;
	} // if
	if (Key == VK_UP) {
		if (y >= 65) y -= 10;
	} // if
	if (Key == VK_DOWN) {
		if (y <= cy-65) y += 10;
	} // if
Invalidate( );
}
//---------------------------------------------------------------------------
void __fastcall TForm3::FormResize(TObject *Sender)
{
	// Сохраняем координаты нижнего правого угла окна
	cx = ClientWidth;
	cy = ClientHeight;
	// Окружность в центре
	x = cx/2;
	y = cy/2;
}
