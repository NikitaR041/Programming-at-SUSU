#pragma resource "*.dfm"
TForm6 *Form6;
//---------------------------------------------------------------------------
__fastcall TForm6::TForm6(TComponent* Owner)
	: TForm(Owner)
{
}
//---------------------------------------------------------------------------
void __fastcall TForm6::ComboBox1Click(TObject *Sender)
{
	wchar_t s1[100];
	StringToWideChar(ComboBox1->Text, s1, 100);
	if (ComboBox1->Text != “”) {
		CppWebBrowser1->Navigate(s1);
	} // if
}
//---------------------------------------------------------------------------
void __fastcall TForm6::ComboBox1KeyDown(TObject *Sender, WORD &Key, TShiftState Shift)

{
	if (Key == VK_RETURN) {
	Key = 0;
	if (ComboBox1->Text == “”) return;
		ComboBox1->Items->Insert(0, ComboBox1->Text);
		ComboBox1Click(Sender);
	} // if
}
//---------------------------------------------------------------------------
void __fastcall TForm6::ComboBox1DblClick(TObject *Sender)
{
    ComboBox1Click(Sender);
}
//---------------------------------------------------------------------------
void __fastcall TForm6::Button1Click(TObject *Sender)
{
	CppWebBrowser1->Refrech( );
}
//---------------------------------------------------------------------------
void __fastcall TForm6::Button2Click(TObject *Sender)
{
    CppWebBrowser1->Stop( );
}
