//---------------------------------------------------------------------------

#include <vcl.h>
#pragma hdrstop

#include "Unit3.h"
//---------------------------------------------------------------------------
#pragma package(smart_init)
#pragma resource "*.dfm"
TForm3 *Form3;
int board[SIZEBOARD][SIZEBOARD];
//---------------------------------------------------------------------------
__fastcall TForm3::TForm3(TComponent* Owner)
	: TForm(Owner)
{
}
//---------------------------------------------------------------------------
void __fastcall TForm3::FormCreate(TObject *Sender)
{
//  Свойства объекта DrawGrid - шахматной поли
	DrawGrid1->ColCount = 8;
	DrawGrid1->RowCount = 8;
	DrawGrid1->DefaultColWidth  = 80;
	DrawGrid1->DefaultRowHeight = 80;
	DrawGrid1->Width  = 8*80 + 11;
	DrawGrid1->Height = 8*80 + 11;
	DrawGrid1->ScrollBars = ssNone;
	DrawGrid1->FixedCols = 0;
	DrawGrid1->FixedRows = 0;
	DrawGrid1->DefaultDrawing = false;

// Центрирование DrawGrid - шахматной поли
	DrawGrid1->Left = (ClientWidth  - DrawGrid1->Width) / 2;
	DrawGrid1->Top  = (ClientHeight - DrawGrid1->Height) / 2;

// Отслеживание при изменении размера формы
	this->OnResize = FormResize;
}
//---------------------------------------------------------------------------

void __fastcall TForm3::FormResize(TObject *Sender)
{
	DrawGrid1->Left = (ClientWidth  - DrawGrid1->Width) / 2;
	DrawGrid1->Top  = (ClientHeight - DrawGrid1->Height) / 2;
}
//---------------------------------------------------------------------------
void InitBoard()
{
	for (int y = 0; y < SIZEBOARD; y++) {
        for (int x = 0; x < SIZEBOARD; x++) {
            if ((x + y) % 2 == 1) { // шашки стоят только на тёмных клетках
                if (y < 3) board[y][x] = BLACK_PAWN;
                else if (y > 4) board[y][x] = WHITE_PAWN;
                else board[y][x] = EMPTY;
            } else {
                board[y][x] = EMPTY;
            }
        }
    }
}

