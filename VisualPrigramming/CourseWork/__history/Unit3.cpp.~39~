// ---- Движок ----

//Проверка выбранной шашки - пустая ячейка или не пустая
bool isValideChecker(int x, int y){
	if (currentPlayer == WHITE_PAWN) {
		return (board[y][x] == WHITE_PAWN || board[y][x] == WHITE_KING);
	} else {
		return (board[y][x] == BLACK_PAWN || board[y][x] == BLACK_KIND);
	}
}

bool isValidMoveChecker(int fromX, int fromY, int toX, int toY){

	// Целевая ячейкка пустая - можно идти
	if (board[toY][toX] != EMPTY) { return false; }

	// Ход по диагонали - можно идти
	if ( abs(toX - formX) != abs(toY - fromX) ) { return false; }

	int piece = board[fromY][fromX];

	//Проверкадля обычной шашки
	if (piece == WHITE_PAWN || piece == BLACK_PAWN) {
		return isValidPawnMove(formX, formY, toX, toY, piece);
	}
	//Проврка для дамки

	return false;
}

bool isValudPawnMove(int fromX, int fromY, int toX, int toY, int piece){
	int direction = (piece == WHITE_PAWN) ? -1 : 1; //Белые вверх, черные вниз
	int deltaY = toY- fromY;
	int deltaX = abs(toX - fromX);

	//Обычный ход на одну клетку
    if (deltaY == direction && deltaX == 1) {
        return true;
    }

    // Ход со взятием (через одну клетку)
    if (deltaY == 2 * direction && deltaX == 2) {
        int midX = (fromX + toX) / 2;
        int midY = (fromY + toY) / 2;

        // Проверяем, что между нами шашка противника
		if (isOpponentPiece(midX, midY, piece)) {
            return true;
        }
	}

	return false;
}

//Проверка на шашку противника
bool isOpponentPiece(int x, int y, int myPiece){
    if (myPiece == WHITE_PAWN || myPiece == WHITE_KING) {
        return (board[y][x] == BLACK_PAWN || board[y][x] == BLACK_KING);
    } else {
        return (board[y][x] == WHITE_PAWN || board[y][x] == WHITE_KING);
	}
}

//Выполнение хода и взятия - взятие доработать
void performMove(int fromX, int fromY, int toX, int toY)
{
    // Перемещаем шашку
    board[toY][toX] = board[fromY][fromX];
    board[fromY][fromX] = EMPTY;

    // Проверяем, был ли ход со взятием
    if (abs(toX - fromX) == 2) {
        // Удаляем шашку противника (посередине)
        int midX = (fromX + toX) / 2;
        int midY = (fromY + toY) / 2;
        board[midY][midX] = EMPTY;

        // TODO: Проверить возможность продолжения взятия
    }
}

// Проверка на превращение дамку
void checkForKing(int x, int y)
{
    if (board[y][x] == WHITE_PAWN && y == 0) {
        board[y][x] = WHITE_KING;
    } else if (board[y][x] == BLACK_PAWN && y == 7) {
        board[y][x] = BLACK_KING;
    }
}
void __fastcall TForm3::DrawGrid1Click(TObject *Sender)
{
    int x = DrawGrid1->Col;
    int y = DrawGrid1->Row;

	if (!isSelected) {
        // Первый клик - выбор шашки
		if (isValideChecker(x, y)) {
			selectedX = x;
            selectedY = y;
            isSelected = true;
            DrawGrid1->Repaint();
        }
    } else {
        // Второй клик - перемещение
		if (isValidMoveChecker(selectedX, selectedY, x, y)) {
            performMove(selectedX, selectedY, x, y);
            isSelected = false;

            // Проверка на превращение в дамку
			checkForKing(x, y);

			// Смена игрока
            currentPlayer = (currentPlayer == WHITE_PAWN) ? BLACK_PAWN : WHITE_PAWN;

            DrawGrid1->Repaint();
        } else {
            // Неверный ход - снимаем выделение
            isSelected = false;
            DrawGrid1->Repaint();
        }
	}
}
